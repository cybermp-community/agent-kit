{
  "name": "cybermp-agent-kit-bridge",
  "version": "0.1.0",
  "description": "Localhost CyberMP RPC bridge for cybermp-agent-kit.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
