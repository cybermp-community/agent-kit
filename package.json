{
  "name": "cybermp-mcp",
  "version": "1.0.0",
  "description": "CyberMP AI Agent Extension & MCP Server",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "cybermp-mcp": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "plugins",
    "templates",
    "rules"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/cli.js",
    "build:index": "tsx scripts/build-index.ts",
    "sync:docs": "tsx scripts/sync-docs.ts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "commander": "^13.1.0",
    "minisearch": "^7.1.2",
    "prompts": "^2.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cybermp/browser-types": "^2.0.1",
    "@cybermp/client-types": "^2.3.6",
    "@cybermp/server-types": "^3.2.8",
    "@types/node": "^22.13.0",
    "@types/prompts": "^2.4.9",
    "ts-morph": "^25.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "yaml": "^2.9.1"
  }
}
