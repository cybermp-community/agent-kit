{
  "name": "cybermp-community-agent-kit",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Workspace for the CyberMP Community Agent Kit CLI, bridge and resource template",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:bridge && pnpm run build:agent-kit && pnpm run build:resource",
    "build:bridge": "pnpm --dir packages/bridge run build",
    "build:agent-kit": "pnpm --dir packages/agent-kit run build",
    "build:resource": "pnpm --dir resources/mcp-bridge run build",
    "build:native": "pnpm --dir packages/agent-kit run build:native",
    "build:index": "pnpm --dir packages/agent-kit run build:index",
    "sync:docs": "pnpm --dir packages/agent-kit run sync:docs",
    "test": "pnpm run test:agent-kit && pnpm run test:bridge",
    "test:agent-kit": "pnpm --dir packages/agent-kit run test",
    "test:bridge": "pnpm --dir packages/bridge run test",
    "check:examples": "pnpm --dir packages/agent-kit run check:examples",
    "test:packed": "pnpm --dir packages/agent-kit run test:packed"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.9"
}
